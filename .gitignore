# ---- SECRETS ----------------------------------------
.env
.env.local
.env.*.local
.env.production
*.key
secrets/

# ---- NODE.JS / FRONTEND ----------------------------
node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js
.next/
out/
build/
dist/

# Vercel
.vercel

# ESLint cache
.eslintcache

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# ---- PYTHON / BACKEND ------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
venv/
env/
.venv/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
*.egg-info/
dist/
*.egg
MANIFEST
.mypy_cache/
.dmypy.json
dmypy.json

# ---- EDITORS / IDE ---------------------------------
.vscode/settings.json
.vscode/launch.json
.vscode/*.log
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# ---- OS --------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
desktop.ini

# ---- LOGS ------------------------------------------
logs/
*.log
npm-debug.log*

# ---- REPORTS (local generated PDFs) ---------------
*.pdf
generated-reports/

# ---- DOCKER ----------------------------------------
.docker/

# ---- MISC ------------------------------------------
.cache/
tmp/
temp/
